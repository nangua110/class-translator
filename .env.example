# 选择翻译/总结用哪家：claude 或 gemini
PROVIDER=claude

# Claude（在 Anthropic 控制台获取）
ANTHROPIC_API_KEY=
# 想省钱可以改成 claude-haiku-4-5 或 claude-sonnet-5-5
CLAUDE_MODEL=claude-opus-5-5

# Gemini（在 Google AI Studio 获取）
GEMINI_API_KEY=
# GEMINI_TRANSLATE_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite   ← 留空即用默认的 6 个模型轮换（免费额度可叠加）
# GEMINI_SUMMARY_MODEL=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite   ← 留空即用默认的 6 个模型轮换（免费额度可叠加）

# 每隔多少秒自动更新一次总结
SUMMARY_INTERVAL_SEC=180

# 默认语言（网页上也可以随时切换）：说话人语言 auto/en/zh/ja…，翻译成 zh/en/ja…
SPEAKER_LANGUAGE=auto
TARGET_LANGUAGE=zh

# 识别方式（网页上也可以切换）：apple 苹果自带识别（本地、边说边出字、不耗额度）；cloud 交给 Gemini 识别；local 用本地 Whisper，免费但发热
ASR_MODE=apple
# GEMINI_ASR_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite   ← 留空即用默认的 6 个模型轮换（免费额度可叠加）
